---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---

<Layout title="Projects | Shourya Tiwary" description="Professional and personal projects by Shourya Tiwary.">
<div class="page">
<div class="fade-in header"><h1>Projects</h1><p class="sub">A selection of professional and personal work.</p></div>
<div class="project-grid">{projects.map((p)=>(<article class="fade-in project-card"><div class="proj-header"><div class="proj-title"><h2 class="proj-name">{p.title}</h2><p class="proj-made mono">{p.category}</p></div>{p.url && (<div class="proj-links"><a href={p.url} target="_blank" rel="noopener" class="icon-link mono">GitHub</a></div>)}</div><p class="proj-date mono">{new Date(p.date).toLocaleDateString('en-US',{year:'numeric',month:'short'})}</p><p class="proj-tag">{p.summary}</p></article>))}</div></div></Layout>
<style>
.page{max-width:680px;margin:0 auto;padding:7rem 1.5rem 2rem}.header{margin-bottom:3rem}h1{font-size:1.9rem;font-weight:600;letter-spacing:-.025em;color:#111}.sub{font-size:.88rem;color:#999}.mono{font-family:"IBM Plex Mono",monospace}.project-grid{display:flex;flex-direction:column;gap:1.25rem}.project-card{border:1px solid #e4e4e4;border-radius:8px;padding:1.4rem 1.5rem;background:#fff}.project-card:hover{border-color:#c8c8c8}.proj-header{display:flex;justify-content:space-between;gap:1rem}.proj-name{margin:0;font-size:1rem}.proj-made{font-size:.68rem;color:#888}.proj-date{font-size:.68rem;color:#999}.proj-tag{font-size:.85rem;line-height:1.7;color:#555}.icon-link{padding:.3rem .7rem;border:1px solid #d0d0d0;border-radius:4px;text-decoration:none;color:#444;background:#f5f5f5}:global([data-theme="dark"]) h1{color:#e8e8e8}:global([data-theme="dark"]) .project-card{background:#1a1a1a;border-color:#2a2a2a}:global([data-theme="dark"]) .proj-name{color:#e8e8e8}:global([data-theme="dark"]) .proj-tag{color:#b0b0b0}
</style>
